+/* Read-only diagnostics; never change GPU modes from a sysfs read. */
+static ssize_t omen_gpu_power_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct victus_gpu_power_modes modes;
+	int ret;
+
+	if (!dmi_match(DMI_BOARD_NAME, "8E41"))
+		return -ENODEV;
+
+	guard(mutex)(&active_platform_profile_lock);
+	ret = hp_wmi_perform_query(HPWMI_GET_GPU_THERMAL_MODES_QUERY, HPWMI_GM,
+				   &modes, sizeof(modes), sizeof(modes));
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+
+	return sysfs_emit(buf, "ctgp=%u ppab=%u dstate=%u slowdown_temp=%u\n",
+			  modes.ctgp_enable, modes.ppab_enable, modes.dstate,
+			  modes.gpu_slowdown_temp);
+}
