#!/bin/sh
# omen-lite fan auto|max   (needs root: sudo omen-lite fan max)
set -e
case "$1 $2" in
    "fan auto") v=2 ;;
    "fan max")  v=0 ;;
    *) echo "usage: sudo omen-lite fan auto|max" >&2; exit 1 ;;
esac
for f in /sys/devices/platform/hp-wmi/hwmon/hwmon*/pwm1_enable; do
    [ -e "$f" ] || { echo "hp-wmi fan control not found" >&2; exit 1; }
    echo "$v" > "$f"
done
